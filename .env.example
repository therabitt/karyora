# Karyora Environment Configuration Example
# Copy this file to .env.local for local development.
# Never commit .env.local or expose production secrets to Git.

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
# Public URL of your Supabase project (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key for client-side queries permitted by RLS (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged service key (SERVER-ONLY - NEVER EXPOSE TO CLIENT / NEVER USE NEXT_PUBLIC_)
# Bypasses RLS for authorized admin workflows and server-only inquiry insertion
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# -----------------------------------------------------------------------------
# Administrator Configuration (Required)
# -----------------------------------------------------------------------------
# Supabase Auth User ID (UUID) for the single provisioned artist-administrator
# Verified in server actions via requireAdmin() against auth.getUser()
KARYORA_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Storage & Upload Lifecycle Configuration
# -----------------------------------------------------------------------------
# Application deadline in seconds after which pending upload finalization is rejected (default: 900 = 15m)
KARYORA_PENDING_UPLOAD_TTL_SECONDS=900

# Safety grace period in seconds before storage cleanup can delete an upload source (default: 600 = 10m)
KARYORA_UPLOAD_CLEANUP_GRACE_SECONDS=600

# -----------------------------------------------------------------------------
# Abuse & Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Secret string used to compute keyed HMAC hashes of client identifiers for commission inquiries
KARYORA_RATE_LIMIT_SECRET=your-random-rate-limit-secret-string

# -----------------------------------------------------------------------------
# Application & Site URL (Optional / Production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
